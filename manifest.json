{
  "manifest_version": 3,
  "name": "Amazon Refund Ledger",
  "short_name": "Refund Ledger",
  "version": "0.18.4",
  "version_name": "0.18.4",
  "description": "Amazon order/refund ledger with authoritative multi-return details, strict crawling, verified payment evidence, and observable local dev auto-updates.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://amazon.com/*",
    "https://www.amazon.com/*",
    "https://business.amazon.com/*",
    "https://*.amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Amazon Refund Ledger",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://amazon.com/*",
        "https://www.amazon.com/*",
        "https://business.amazon.com/*",
        "https://*.amazon.com/*"
      ],
      "js": [
        "storage.js",
        "parser.js",
        "content.js",
        "workflow-recorder.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
